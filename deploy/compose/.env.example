# 复制为 .env 后填写真实值;.env 已被 .gitignore 排除,禁止入库
# NACOS_AUTH_TOKEN 要求原文 ≥32 字节的 Base64,生成方式:openssl rand -base64 64
POSTGRES_IAM_DB=shortlink_iam
POSTGRES_LINK_DB=shortlink_link
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=change-me-pg

REDIS_PASSWORD=change-me-redis

NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=change-me-identity
# Nacos 3 管理员初始化接口固定创建 nacos 账号，请勿修改此用户名。
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# 仅用于本地开发；生产环境必须使用带 {bcrypt} 前缀的密钥哈希并妥善保管原文。
IAM_LINK_CLIENT_SECRET=change-me-link-client
IAM_LINK_CLIENT_SECRET_HASH={noop}change-me-link-client
OAUTH_CLIENT_SECRET={noop}change-me-smoke-client
# 生成方式：openssl rand -base64 32。已有数据必须始终使用同一密钥。
IAM_SIGNING_KEY_ENCRYPTION_KEY=

IAM_ISSUER=http://127.0.0.1:8080
IAM_API_AUDIENCE=linkforge-api
SPA_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback
SPA_LOCALHOST_REDIRECT_URI=http://localhost:5173/oauth/callback
SPA_ALLOWED_ORIGIN=http://127.0.0.1:5173
SPA_LOCALHOST_ALLOWED_ORIGIN=http://localhost:5173

OTEL_TRACES_ENABLED=true
OTEL_TRACES_SAMPLING_PROBABILITY=1.0
